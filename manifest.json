{
  "manifest_version": 3,
  "name": "Worldlet",
  "short_name": "Worldlet",
  "version": "1.0.0",
  "description": "A tiny living 3D world in every new tab, with live weather, quick links, tasks, notes and a focus timer.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "geolocation", "favicon"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
